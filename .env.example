# Copie para .env e ajuste conforme necessário. docker-compose já injeta
# estes valores automaticamente para os serviços orquestrados; este arquivo
# serve para rodar a API/workers localmente fora do compose.

PORT=3000

# Postgres hospedado no Neon (https://neon.tech). Copie a connection
# string do painel do seu projeto Neon — ela já vem com ?sslmode=require,
# que o mikro-orm.config.ts detecta automaticamente para habilitar TLS.
# Prefira o endpoint "pooled" (com "-pooler" no host) se for rodar várias
# réplicas de worker; o endpoint direto também funciona para poucas
# conexões simultâneas.
DATABASE_URL=postgresql://neondb_owner:npg_2rsNf1knGSQE@ep-noisy-dream-ac27y44s-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

LOG_LEVEL=info
MIKRO_ORM_DEBUG=false

OUTBOX_PUBLISHER_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
PENDING_REFERENCE_INTERVAL_MS=10000
PENDING_REFERENCE_BATCH_SIZE=100
CONSUMER_NAME=wager-transactions-consumer
